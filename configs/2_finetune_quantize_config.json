{
  "model": {
    "head_num": 4,
    "quantize": true,
    "gaussian_head_config": {
      "encoder": {
        "backbone": "dinov3_vitb16",
        "intermediate_layers": [5, 11],
        "dim_out": 1024
      },
      "neck": {
        "dim_in": [1026, 2, 2, 2, 2],
        "dim_out": null,
        "dim_res_blocks": [1024, 256, 128, 64, 32],
        "num_res_blocks": [0, 2, 2, 2, 0],
        "res_block_in_norm": "none",
        "res_block_hidden_norm": "none",
        "resamplers": [
          "conv_transpose",
          "conv_transpose",
          "conv_transpose",
          "bilinear"
        ]
      },
      "gaussian_feat_decoder": {
        "dim_in": [1024, 256, 128, 64, 32],
        "dim_out": [null, null, null, null, 32],
        "dim_res_blocks": [1024, 256, 128, 64, 32],
        "num_res_blocks": [0, 1, 1, 1, 0],
        "res_block_in_norm": "none",
        "res_block_hidden_norm": "none",
        "resamplers": [
          "conv_transpose",
          "conv_transpose",
          "conv_transpose",
          "bilinear"
        ]
      },
      "patch_embedding": {
        "in_dim": 32,
        "out_dim": 64,
        "patch_size": 7
      }
    }
  },
  "train_data": {
    "area_range": [160000, 640000],
    "aspect_ratio_range": [0.5, 2.0],
    "image_augmentation": ["jittering", "jpeg_loss", "blurring", "shot_noise"],
    "accept_image_format": [".png", ".jpg", ".jpeg", ".webp", ".PNG", ".JPG", ".JPEG", ".WEBP"],
    "datasets": [
      {
        "name": "ImageNet",
        "path": "/home/zzj/Data/ImageNet/train",
        "weight": 1.0, 
        "label_type": "normal"
      }
    ]
  },
  "valid_data": {
    "max_valid_num": 10,
    "area_range": [160000, 640000],
    "aspect_ratio_range": [0.5, 2.0],
    "accept_image_format": [".png", ".jpg", ".jpeg", ".webp", ".PNG", ".JPG", ".JPEG", ".WEBP"],
    "datasets": [
      {
        "name": "ImageNet",
        "path": "/home/zzj/Data/ImageNet/val",
        "weight": 1.0, 
        "label_type": "normal"
      }
    ]
  },
  "optimizer": {
    "type": "AdamW",
    "params": [
      {"params": {"include": ["*"], "exclude": ["*backbone.*", "*feed_forward_gaussian_codec.*"]}, "lr": 1.25e-5},
      {"params": {"include": ["*backbone.*"]}, "lr": 1.25e-6},
      {"params": {"include": ["*feed_forward_gaussian_codec.*"]}, "lr": 1e-4}
  ]
  },
  "lr_scheduler": {
      "type": "StepLR", "params": {"step_size": 5, "gamma": 0.5}
  }
}